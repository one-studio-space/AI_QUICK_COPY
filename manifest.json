{
  "manifest_version": 3,
  "name": "AI Quick Copy",
  "version": "1.4.1",
  "description": "Copy the AI response you are reading as Markdown from ChatGPT, Gemini, Grok, or Claude.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "AI Quick Copy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "core.js",
        "settings.js",
        "markdown.js",
        "block.js",
        "sites/chatgpt.js",
        "sites/gemini.js",
        "sites/grok.js",
        "sites/claude.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
